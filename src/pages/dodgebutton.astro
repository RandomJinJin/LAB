---
import SiteHeader from "../components/SiteHeader.astro";
import DodgeButtonWidget from "../features/dodgebutton/DodgeButtonWidget.astro";
import "../styles/global.css";

const title = "DodgeButton · LAB";
const description = "一个会躲开鼠标的按钮。";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="https://img.randomjin.top/logo/logo.png" />
  </head>
  <body>
    <SiteHeader
      crumbs={[
        { label: "LAB", href: "https://lab.randomjin.top/" },
        { label: "DodgeButton" },
      ]}
    />
    <div class="project-shell">
      <main class="project-main flex items-center justify-center">
        <DodgeButtonWidget />
      </main>
    </div>
  </body>
</html>

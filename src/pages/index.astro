---
import "../styles/global.css";
import ProjectGrid from "../components/ProjectGrid";
import SiteHeader from "../components/SiteHeader.astro";
import { projects } from "../data/projects";

const year = new Date().getFullYear();
const title = "LAB · 今斤";
const description = "项目实验室：自用工具、实验与 prompt 片段的集合。";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f5f5" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://lab.randomjin.top" />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" href="/logo.png" />
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <main class="mx-auto w-full max-w-5xl px-6 sm:px-8">
      <header class="pt-10 sm:pt-16">
        <SiteHeader />

        <div class="mt-14 border-b border-border pb-8 sm:mt-20">
          <p class="font-mono text-xs uppercase tracking-[0.3em] text-muted-foreground">
            Project Index
          </p>
          <h1 class="mt-4 text-[clamp(3.5rem,12vw,7rem)] leading-[0.9] font-semibold tracking-[-0.05em]">
            LAB
          </h1>
          <p class="mt-6 max-w-xl text-sm leading-7 text-muted-foreground">
            一些自用的工具、实验与 prompt 片段。点击卡片进入对应项目。
          </p>
        </div>
      </header>

      <section class="mt-10 pb-24 sm:mt-12" aria-label="项目列表">
        <ProjectGrid client:load projects={projects} />
      </section>

      <footer class="flex flex-col gap-2 border-t border-border py-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
        <p>© {year} 今斤</p>
        <p class="font-mono">lab.randomjin.top</p>
      </footer>
    </main>
  </body>
</html>

---
import SiteHeader from "../components/SiteHeader.astro";
import { ScrapsStack } from "../features/chatbubble";
import "../styles/global.css";

const title = "ChatBubble · LAB";
const description = "柔和纸色聊天消息气泡 · 卡片堆叠";
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="https://img.randomjin.top/logo/logo.png" />
  </head>
  <body>
    <SiteHeader
      crumbs={[
        { label: "LAB", href: "https://lab.randomjin.top/" },
        { label: "ChatBubble" },
      ]}
    />
    <div class="project-shell">
      <main class="project-main">
        <ScrapsStack client:load />
      </main>
    </div>
  </body>
</html>

<style is:global>
  .project-main {
    padding-top: var(--site-header-height);
  }
</style>
